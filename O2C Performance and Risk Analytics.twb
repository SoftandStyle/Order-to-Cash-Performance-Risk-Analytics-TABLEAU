            <column-instance column='[Calculation_1068455519703040]' derivation='User' name='[usr:Calculation_1068455519703040:qk]' pivot='key' type='quantitative' />
            <column-instance column='[InvoiceDate]' derivation='Year' name='[yr:InvoiceDate:ok]' pivot='key' type='ordinal' />
          </datasource-dependencies>
