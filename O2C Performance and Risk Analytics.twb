      <aliases enabled='yes' />
      <column caption='Actual Days Late' datatype='integer' name='[ActualDaysLate]' role='measure' type='quantitative' />
      <column caption='Aging Bucket' datatype='string' name='[AgingBucket]' role='dimension' type='nominal' />
      <column caption='Country Filter' datatype='boolean' name='[Calculation_0779284397338624]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[CountryName] IN [Country Name Set]' />
      </column>
      <column caption='At-Risk Capital' datatype='real' name='[Calculation_0779284416106497]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [AgingBucket] != &apos;0. On Time&apos; THEN [InvoiceAmount] ELSE 0 END' />
      </column>
      <column caption='CY _PastDue' datatype='real' name='[Calculation_0779284420222978]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF YEAR([InvoiceDate]) = 2013 THEN [Calculation_0779284416106497] END' />
      </column>
      <column caption='PY_PastDue' datatype='real' name='[Calculation_0779284420743171]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF YEAR([InvoiceDate]) = 2012 THEN [Calculation_0779284416106497] END' />
      </column>
      <column caption='CYvsPY_PastDue' datatype='real' default-format='*▲ $#,##0; ▼ $#,##0; $0' name='[Calculation_0779284421017604]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_0779284420222978]) - SUM([Calculation_0779284420743171])' />
      </column>
      <column caption='Country_RiskRatio' datatype='real' default-format='p0.00%' name='[Calculation_0779284429185029]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_0779284416106497]) / SUM({FIXED [CountryName] : SUM([InvoiceAmount])})' />
      </column>
      <column caption='Value/Volume' datatype='real' name='[Calculation_1068455519703040]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;    WHEN &apos;Value&apos; THEN SUM([InvoiceAmount])&#13;&#10;    WHEN &apos;Volume&apos; THEN COUNT([invoiceNumber])&#13;&#10;END' />
      </column>
      <column caption='CY_DaysLate' datatype='integer' name='[Calculation_1068455536844804]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF YEAR([InvoiceDate]) = 2013 THEN [ActualDaysLate] END' />
      </column>
      <column caption='PY_DaysLate' datatype='integer' name='[Calculation_1068455536943109]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF YEAR([InvoiceDate]) = 2012 THEN [ActualDaysLate] END' />
      </column>
      <column caption='CYvsPY_DaysLate' datatype='real' default-format='*▲ 0.0; ▼ 0.0; 0.0' name='[Calculation_1068455537078278]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Calculation_1068455536844804]) - AVG([Calculation_1068455536943109])' />
      </column>
