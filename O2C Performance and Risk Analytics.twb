            <groupfilter function='level-members' level='[CountryName]' user:ui-action-filter='[Action4_E0F7541BC88F49489E1B93E0731890CC]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column='[federated.0jbvji9157nayw1co5l6102z4gh7].[Action (MONTH(Invoice Date)) 1]'>
            <groupfilter function='level-members' level='[mn:InvoiceDate:ok]' user:ui-action-filter='[Action3_BF3B49763F6B400082548F942B3514A9]' user:ui-enumeration='all' user:ui-marker='enumerate' />
