            <column caption='Value/Volume' datatype='real' name='[Calculation_1068455519703040]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;    WHEN &apos;Value&apos; THEN SUM([InvoiceAmount])&#13;&#10;    WHEN &apos;Volume&apos; THEN COUNT([invoiceNumber])&#13;&#10;END' />
            </column>
            <column caption='Country Name' datatype='string' name='[CountryName]' role='dimension' semantic-role='[Country].[Name]' type='nominal' />
            <column caption='Invoice Amount' datatype='real' name='[InvoiceAmount]' role='measure' type='quantitative' />
